import sys,os
import numpy as np
def s(n):
    sum=0
    for i in range(n):
        sum=sum+i+1
    return sum
    
def sp(n):
    sum=0
    prod=1
    for i in range(1,n):
        sum=sum+i+1
        prod=prod*i
    return sum,prod
    
def sommarad(n):
    sum=0
    for i in range(n):
        sum=sum+np.sqrt(i+1)
    return sum

def sexp(a,b=1):
    sum=0
    for i in range(a):
        sum=sum+(i**b)
    return sum

        


